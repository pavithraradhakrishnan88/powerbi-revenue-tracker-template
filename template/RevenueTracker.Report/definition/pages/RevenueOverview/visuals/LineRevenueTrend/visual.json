{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.3.0/schema.json",
  "name": "LineRevenueTrend",
  "position": {
    "x": 640,
    "y": 160,
    "z": 3000,
    "width": 620,
    "height": 280,
    "tabOrder": 3000
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Date"
                    }
                  },
                  "Property": "MonthYear"
                }
              },
              "queryRef": "Dim_Date.MonthYear",
              "nativeQueryRef": "MonthYear"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Revenue"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "Fact_Revenue.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "objects": {}
  }
}
