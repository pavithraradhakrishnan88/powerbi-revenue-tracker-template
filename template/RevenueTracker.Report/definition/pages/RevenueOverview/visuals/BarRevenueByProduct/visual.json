{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.3.0/schema.json",
  "name": "BarRevenueByProduct",
  "position": {
    "x": 32,
    "y": 396,
    "z": 2000,
    "width": 560,
    "height": 292,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Dim_Product"
                    }
                  },
                  "Property": "ProductName"
                }
              },
              "queryRef": "Dim_Product.ProductName",
              "nativeQueryRef": "ProductName"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Fact_Revenue"
                    }
                  },
                  "Property": "Total Revenue"
                }
              },
              "queryRef": "Fact_Revenue.Total Revenue",
              "nativeQueryRef": "Total Revenue"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "defaultColor": {
              "solid": {
                "color": "#7B5CFA"
              }
            }
          }
        }
      ]
    }
  }
}